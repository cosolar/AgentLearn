# ============================================
# AgentLearn 环境变量配置
# 用法：cp .env.example .env  然后填入你的 Key
# ============================================

# ---------- 教程统一约定（推荐）----------
# 本教程与 docs/ 中的示例统一使用 LLM_* 三个变量，
# 便于在 OpenAI / Anthropic / Gemini / DeepSeek / 通义 之间切换。
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-5.5

# ---------- langchain-openai 原生变量（可选）----------
# ChatOpenAI 默认读取 OPENAI_API_KEY / OPENAI_API_BASE。
# examples/ 下的示例未显式传 key，因此这两者任填其一即可跑通。
# OPENAI_API_KEY=sk-...
# OPENAI_API_BASE=https://api.openai.com/v1

# ---------- 其他模型提供商（可选）----------
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...
# DEEPSEEK_API_KEY=...
# DASHSCOPE_API_KEY=...            # 通义千问

# ---------- 可观测性：LangSmith（可选）----------
# 注意：旧版 LANGCHAIN_* 前缀已改为 LANGSMITH_*
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=ls-...
LANGSMITH_PROJECT=agentlearn

# ---------- 向量数据库（可选）----------
# CHROMA_PERSIST_DIRECTORY=./chroma_db
# QDRANT_URL=http://localhost:6333

# ---------- 应用配置 ----------
APP_NAME=AgentLearn
APP_ENVIRONMENT=development
LOG_LEVEL=INFO
